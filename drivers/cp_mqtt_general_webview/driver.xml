<devicedata>
  <name>MQTT General w Webview</name>
  <version/>
  <manufacturer>Control Pro</manufacturer>
  <model>MQTT General w Webview</model>
  <creator>Chris Toth</creator>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>
  <control>lua_gen</control>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 Control Pro. All rights reserved.</copyright>
  <created>10/30/2026 12:00:00 PM</created>
  <modified/>
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Misc</category>
  </composer_categories>
  <proxies>
    <proxy proxybindingid="5001" name="MQTT General w Webview" image_source="c4z" small_image="icons/device_sm.png" large_image="icons/device_lg.png">uibutton</proxy>
  </proxies>
  <conditionals/>
  <events>
    <event>
      <id>1</id>
      <name>Values Updated</name>
      <description>NAME received new MQTT values</description>
    </event>
    <event>
      <id>2</id>
      <name>Air Quality Changed</name>
      <description>NAME air quality level changed</description>
    </event>
    <event>
      <id>3</id>
      <name>Data Stale</name>
      <description>NAME has not received MQTT data within the stale timeout</description>
    </event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <actions>
      <action>
        <name>Resubscribe</name>
        <command>Resubscribe</command>
      </action>
      <action>
        <name>Refresh Web View</name>
        <command>Refresh Web View</command>
      </action>
      <action>
        <name>Clear Values</name>
        <command>Clear Values</command>
      </action>
    </actions>
    <properties>
      <property>
        <name>Driver Settings</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <default>3 - Info</default>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <property>
        <name>MQTT Settings</name>
        <type>LABEL</type>
        <default>MQTT Settings</default>
      </property>
      <property>
        <name>MQTT Topics</name>
        <type>STRING</type>
        <default/>
        <description>Topic(s) to read, comma separated (e.g. zigbee2mqtt/Vindstyrka). JSON payloads are split into one value per field.</description>
      </property>
      <property>
        <name>QoS</name>
        <type>LIST</type>
        <default>0</default>
        <items>
          <item>0</item>
          <item>1</item>
          <item>2</item>
        </items>
      </property>
      <property>
        <name>Last Message</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Last Payload</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Current Values</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Display Settings</name>
        <type>LABEL</type>
        <default>Display Settings</default>
      </property>
      <property>
        <name>Title</name>
        <type>STRING</type>
        <default/>
        <description>Heading shown on the web view. Empty uses the driver name.</description>
      </property>
      <property>
        <name>Theme</name>
        <type>LIST</type>
        <default>Dark</default>
        <items>
          <item>Dark</item>
          <item>Light</item>
          <item>Auto</item>
        </items>
      </property>
      <property>
        <name>Field Order</name>
        <type>STRING</type>
        <default/>
        <description>Fields to show, in this order, comma separated (e.g. pm25,voc_index,temperature,humidity). They are always shown, with -- until a value arrives. Empty shows every received field.</description>
      </property>
      <property>
        <name>Received Fields</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
        <description>Every field ever received over MQTT.</description>
      </property>
      <property>
        <name>Received Fields Action</name>
        <type>LIST</type>
        <default>(Select)</default>
        <items>
          <item>(Select)</item>
          <item>Copy All to Field Order</item>
          <item>Clear</item>
        </items>
        <description>Copy All to Field Order puts every received field (except Hidden Fields) in Field Order. Clear empties Received Fields.</description>
      </property>
      <property>
        <name>Hidden Fields</name>
        <type>STRING</type>
        <default>update*,last_seen,identify</default>
        <description>Keys to hide when Field Order is empty, and to leave out of Copy All to Field Order. * is a wildcard (e.g. update*).</description>
      </property>
      <property>
        <name>Field Labels</name>
        <type>STRING</type>
        <default/>
        <description>Custom label and unit per key, separated by ';' (e.g. pm25=Fine dust|µg/m³; voc_index=Air quality|).</description>
      </property>
      <property>
        <name>Temperature Display</name>
        <type>LIST</type>
        <default>As Received</default>
        <items>
          <item>As Received</item>
          <item>Celsius to Fahrenheit</item>
          <item>Fahrenheit to Celsius</item>
          <item>Source is Fahrenheit</item>
        </items>
      </property>
      <property>
        <name>Stale After (minutes)</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>1440</maximum>
        <default>15</default>
        <description>Mark data as stale when nothing arrives for this long. 0 disables.</description>
      </property>
      <property>
        <name>Web View URL</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Variables</name>
        <type>LABEL</type>
        <default>Variables</default>
      </property>
      <property>
        <name>Create Variables</name>
        <type>LIST</type>
        <default>Yes</default>
        <items>
          <item>Yes</item>
          <item>No</item>
        </items>
        <description>Create a Control4 variable per value for use in programming.</description>
      </property>
    </properties>
  </config>
  <capabilities>
    <!-- Laid out like Control4's WebView driver (webview.c4z): a protocol driver (not a
         combo) with a uibutton proxy, so Composer adds a device that can be shown in a
         room's Comfort (or any Experience) menu. The page is served by the controller from
         this driver's www/ folder; the path after controller://driver/ MUST equal the .c4z
         file name, and the driver re-sends URL_CHANGED with its real file name. -->
    <web_view_url proxybindingid="5001">controller://driver/cp_mqtt_general_webview/dashboard/index.html</web_view_url>
    <!-- Show the web view in the iOS/Android apps as well (OS 3.1.3+, app 321.46+). -->
    <mobile_web_view_enabled>true</mobile_web_view_enabled>
    <navigator_display_option proxybindingid="5001">
      <Icon height="70" width="70">controller://driver/cp_mqtt_general_webview/icons/nav/unknown_70.png</Icon>
      <Icon height="90" width="90">controller://driver/cp_mqtt_general_webview/icons/nav/unknown_90.png</Icon>
      <Icon height="300" width="300">controller://driver/cp_mqtt_general_webview/icons/nav/unknown_300.png</Icon>
      <display_icons>
        <state id="default">
          <Icon height="70" width="70">controller://driver/cp_mqtt_general_webview/icons/nav/unknown_70.png</Icon>
          <Icon height="90" width="90">controller://driver/cp_mqtt_general_webview/icons/nav/unknown_90.png</Icon>
          <Icon height="300" width="300">controller://driver/cp_mqtt_general_webview/icons/nav/unknown_300.png</Icon>
        </state>
        <state id="unknown">
          <Icon height="70" width="70">controller://driver/cp_mqtt_general_webview/icons/nav/unknown_70.png</Icon>
          <Icon height="90" width="90">controller://driver/cp_mqtt_general_webview/icons/nav/unknown_90.png</Icon>
          <Icon height="300" width="300">controller://driver/cp_mqtt_general_webview/icons/nav/unknown_300.png</Icon>
        </state>
        <state id="good">
          <Icon height="70" width="70">controller://driver/cp_mqtt_general_webview/icons/nav/good_70.png</Icon>
          <Icon height="90" width="90">controller://driver/cp_mqtt_general_webview/icons/nav/good_90.png</Icon>
          <Icon height="300" width="300">controller://driver/cp_mqtt_general_webview/icons/nav/good_300.png</Icon>
        </state>
        <state id="fair">
          <Icon height="70" width="70">controller://driver/cp_mqtt_general_webview/icons/nav/fair_70.png</Icon>
          <Icon height="90" width="90">controller://driver/cp_mqtt_general_webview/icons/nav/fair_90.png</Icon>
          <Icon height="300" width="300">controller://driver/cp_mqtt_general_webview/icons/nav/fair_300.png</Icon>
        </state>
        <state id="poor">
          <Icon height="70" width="70">controller://driver/cp_mqtt_general_webview/icons/nav/poor_70.png</Icon>
          <Icon height="90" width="90">controller://driver/cp_mqtt_general_webview/icons/nav/poor_90.png</Icon>
          <Icon height="300" width="300">controller://driver/cp_mqtt_general_webview/icons/nav/poor_300.png</Icon>
        </state>
        <state id="bad">
          <Icon height="70" width="70">controller://driver/cp_mqtt_general_webview/icons/nav/bad_70.png</Icon>
          <Icon height="90" width="90">controller://driver/cp_mqtt_general_webview/icons/nav/bad_90.png</Icon>
          <Icon height="300" width="300">controller://driver/cp_mqtt_general_webview/icons/nav/bad_300.png</Icon>
        </state>
      </display_icons>
    </navigator_display_option>
  </capabilities>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>UIBUTTON</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>UIBUTTON</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>5002</id>
      <facing>6</facing>
      <connectionname>MQTT Broker</connectionname>
      <type>2</type>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>CP_MQTT_BROKER</classname>
          <autobind>True</autobind>
        </class>
      </classes>
      <hidden>False</hidden>
    </connection>
  </connections>
</devicedata>
