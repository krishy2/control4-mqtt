<devicedata>
  <name>MQTT Broker</name>
  <version/>
  <manufacturer>Control Pro</manufacturer>
  <model>MQTT Broker</model>
  <creator>Chris Toth</creator>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 Control Pro. All rights reserved.</copyright>
  <created>06/06/2025 12:00:00 PM</created>
  <modified/>
  <combo>true</combo>
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Utility</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>BROKER_CONNECTED</name>
      <type>BOOL</type>
      <condition_statement>MQTT broker connection status</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Connected</true_text>
      <false_text>Disconnected</false_text>
    </conditional>
  </conditionals>
  <events>
    <event>
      <id>1</id>
      <name>Broker Connected</name>
      <description>When NAME connects to the MQTT broker</description>
    </event>
    <event>
      <id>2</id>
      <name>Broker Disconnected</name>
      <description>When NAME disconnects from the MQTT broker</description>
    </event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <property>
        <name>Updates</name>
        <type>LABEL</type>
        <default>Update Settings</default>
      </property>
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <property>
        <name>Update Channel</name>
        <type>LIST</type>
        <default>Production</default>
        <items>
          <item>Production</item>
          <item>Prerelease</item>
        </items>
      </property>
      <property>
        <name>Driver</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <default>3 - Info</default>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <property>
        <name>Broker Mode</name>
        <type>LIST</type>
        <default>External</default>
        <items>
          <item>External</item>
          <item>Built-in</item>
        </items>
        <description>External: connect to an MQTT broker on the network. Built-in: the controller is the broker and devices connect to it on Listen Port.</description>
      </property>
      <property>
        <name>Tasmota Devices</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
        <description>Tasmota devices found through discovery (SetOption19 0, the Tasmota default)</description>
      </property>
      <property>
        <name>Broker Settings</name>
        <type>LABEL</type>
        <default>Broker Settings</default>
      </property>
      <property>
        <name>Broker Address</name>
        <type>STRING</type>
        <default/>
        <description>IP address or hostname of the MQTT broker</description>
      </property>
      <property>
        <name>Port</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>65535</maximum>
        <default>1883</default>
      </property>
      <property>
        <name>Username</name>
        <type>STRING</type>
        <default/>
        <description>MQTT broker username (optional)</description>
      </property>
      <property>
        <name>Password</name>
        <type>STRING</type>
        <default/>
        <password>true</password>
      </property>
      <property>
        <name>Keep Alive</name>
        <type>RANGED_INTEGER</type>
        <minimum>10</minimum>
        <maximum>3600</maximum>
        <default>60</default>
        <description>Keep-alive interval in seconds</description>
      </property>
      <property>
        <name>Built-in Broker</name>
        <type>LABEL</type>
        <default>Built-in Broker</default>
      </property>
      <property>
        <name>Listen Port</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>65535</maximum>
        <default>3883</default>
        <description>Port devices connect to. 1883 is used by the controller's own broker.</description>
      </property>
      <property>
        <name>Max Clients</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>1000</maximum>
        <default>250</default>
        <description>Refuse new connections above this many</description>
      </property>
      <property>
        <name>Connected Devices</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
        <description>MQTT devices connected to the built-in broker</description>
      </property>
      <property>
        <name>Messages per Second</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
        <description>Messages received per second, last 5 seconds</description>
      </property>
      <property>
        <name>Broker Errors</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
        <description>Protocol, socket and driver errors since start. Should stay 0.</description>
      </property>
      <property>
        <name>Timer Lag</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
        <description>How late a 1-second timer fires: a measure of how busy Director is</description>
      </property>
    </properties>
    <actions>
      <action>
        <name>Update Drivers</name>
        <command>UpdateDrivers</command>
      </action>
      <action>
        <name>Reconnect</name>
        <command>Reconnect</command>
      </action>
      <action>
        <name>Print Clients</name>
        <command>PrintClients</command>
      </action>
      <action>
        <name>Print Retained</name>
        <command>PrintRetained</command>
      </action>
      <action>
        <name>Print Report</name>
        <command>PrintReport</command>
      </action>
      <action>
        <name>Reset Statistics</name>
        <command>ResetStatistics</command>
      </action>
      <action>
        <name>Print Tasmota Devices</name>
        <command>PrintTasmotaDevices</command>
      </action>
      <action>
        <name>Forget Tasmota Devices</name>
        <command>ForgetTasmotaDevices</command>
      </action>
    </actions>
  </config>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>MQTT Broker</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>CP_MQTT_BROKER</classname>
        </class>
      </classes>
      <hidden>False</hidden>
    </connection>
  </connections>
</devicedata>
