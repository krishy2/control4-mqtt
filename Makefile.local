# Project-specific additions to the template Makefile (included at its end).

# ─── Driver version ──────────────────────────────────────────────────────────
# Every local build gets a higher driver version than the previous one: today's
# date (YYYYMMDD), or the last built version + 1 if that is already today or
# later. The last version is kept in dist/ (git-ignored), so it is per checkout.
#
# Only replaces the template's default. A DRIVER_VERSION passed on the command
# line or in the environment (the CI tag build does this) is left alone.
DRIVER_VERSION_STATE := dist/.last-driver-version

ifeq ($(origin DRIVER_VERSION),file)
DRIVER_VERSION := $(shell python3 tools/driver_version.py next $(DRIVER_VERSION_STATE))
endif

.PHONY: record-driver-version
record-driver-version:
	@python3 tools/driver_version.py record $(DRIVER_VERSION_STATE) $(DRIVER_VERSION)
	@echo "Built driver version $(DRIVER_VERSION)"

# Runs after the stock build steps, so a failed build does not use up a version.
build build-nodocs: record-driver-version
