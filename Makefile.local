# Project-specific additions to the template Makefile (included at its end).

# ─── Driver version ──────────────────────────────────────────────────────────
# Every local build gets a higher driver version than the previous one:
# YYYYMMDDNN, today's date with build number 00, or the last built version + 1
# if that is already today or later (01, 02, ... on the same day). The last
# version is kept in dist/ (git-ignored), so it is per checkout.
#
# Only replaces the template's default. A DRIVER_VERSION passed on the command
# line or in the environment (the CI tag build does this) is left alone.
DRIVER_VERSION_STATE := dist/.last-driver-version

ifeq ($(origin DRIVER_VERSION),file)
DRIVER_VERSION := $(shell python3 tools/driver_version.py next $(DRIVER_VERSION_STATE))
endif

.PHONY: record-driver-version
record-driver-version:
	@python3 tools/driver_version.py record $(DRIVER_VERSION_STATE) $(DRIVER_VERSION)
	@echo "Built driver version $(DRIVER_VERSION)"

# Runs after the stock build steps, so a failed build does not use up a version.
build build-nodocs: record-driver-version

# ─── README ───────────────────────────────────────────────────────────────────
# The README is generated from the broker driver's documentation. The drivers
# carry a cp_ prefix so they never share a file name with other MQTT drivers.
README_DRIVER := cp_mqtt_broker

# ─── Experiments ─────────────────────────────────────────────────────────────
# Test drivers under experiments/ are built on their own and never go into a
# release. Output: dist/experiments/<name>.c4z

EXPERIMENT_DIR := build/oss/drivers/mqtt_server_test

.PHONY: mqtt-server-test
mqtt-server-test: ## Build the step 0 MQTT Server Test driver (experiments/, not released)
	./tools/preprocess.py --oss
	rm -rf $(EXPERIMENT_DIR)
	mkdir -p $(EXPERIMENT_DIR) dist/experiments dist/oss/source
	cp -r experiments/mqtt_server_test/driver.lua experiments/mqtt_server_test/driver.xml \
		experiments/mqtt_server_test/driver.c4zproj experiments/mqtt_server_test/www $(EXPERIMENT_DIR)/
	python3 tools/package.py xml-set $(EXPERIMENT_DIR)/driver.xml version "$(DRIVER_VERSION)"
	python3 tools/package.py xml-set $(EXPERIMENT_DIR)/driver.xml modified "$$(date +'%m/%d/%Y %I:%M %p')"
	cd $(EXPERIMENT_DIR) && luajit ../../../../tools/gen-squishy.lua
	$(VENV_PY) tools/docs.py md2html $(EXPERIMENT_DIR)/www/documentation/index.md $(EXPERIMENT_DIR)/www/documentation
	cd $(EXPERIMENT_DIR) && "$(CURDIR)/$(VENV_PY)" "$(CURDIR)/$(PACKAGER)" . "$(CURDIR)/dist/experiments" driver.c4zproj
	@$(MAKE) --no-print-directory record-driver-version DRIVER_VERSION=$(DRIVER_VERSION)
